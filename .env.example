# =============================================================================
# Environment configuration — copy to .env and fill in real values.
# NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
APP_ENV=dev                  # dev | staging | prod
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
APP_SECRET_KEY=please-change-me-to-a-64-char-random-string
GIT_SHA=dev

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag
DATABASE_URL_SYNC=postgresql://rag:rag@postgres:5432/rag
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# Redis (for caching)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_EMBEDDING_TTL=86400     # 1 day
REDIS_QUERY_TTL=300           # 5 minutes

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_STRONG_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# -----------------------------------------------------------------------------
# Embeddings + Reranker
# -----------------------------------------------------------------------------
# Local models (downloaded from Hugging Face on first use)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Offline deterministic providers for tests/CI (no HF downloads):
#   EMBEDDING_MODEL=test-hashed-bag  RERANKER_MODEL=test-passthrough
#   OPENAI_API_KEY=sk-test  (mock LLM; see src/llm/provider.py)

HF_TOKEN=hf_your-hugging-face-token

# Or use OpenAI embeddings instead:
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=3072

# -----------------------------------------------------------------------------
# Auth (JWT)
# -----------------------------------------------------------------------------
JWT_SECRET=please-change-me-to-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry + Langfuse)
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://langfuse:3000/api/otel
OTEL_SERVICE_NAME=agentic-rag-api
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_SECRET=lf-secret-please-change
LANGFUSE_PUBLIC=lf-public-please-change

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -----------------------------------------------------------------------------
# Agent limits
# -----------------------------------------------------------------------------
AGENT_MAX_STEPS=8
AGENT_MAX_RETRIES_PER_STEP=2
AGENT_GLOBAL_TIMEOUT_SECONDS=30
AGENT_MAX_TOOL_CALLS=10

# -----------------------------------------------------------------------------
# Retrieval defaults
# -----------------------------------------------------------------------------
RETRIEVAL_CANDIDATE_COUNT=50
RETRIEVAL_TOP_K=10
RERANKER_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.2

# -----------------------------------------------------------------------------
# Memory
# -----------------------------------------------------------------------------
MEMORY_SHORT_TERM_WINDOW=10
MEMORY_EXTRACTION_ENABLED=true
MEMORY_MAX_PER_USER=500

# -----------------------------------------------------------------------------
# Ingestion
# -----------------------------------------------------------------------------
INGESTION_CHUNK_SIZE=512
INGESTION_CHUNK_OVERLAP=64
INGESTION_CHUNK_STRATEGY=structure-aware  # fixed | sliding | semantic | structure-aware
INGESTION_BATCH_SIZE=100

# -----------------------------------------------------------------------------
# Evaluation (CI quality gate)
# -----------------------------------------------------------------------------
EVAL_FAITHFULNESS_MIN=0.85
EVAL_HALLUCINATION_RATE_MAX=0.10
EVAL_SMOKE_SIZE=10
